#!/bin/bash
# bin/lg — the one entry point for LocalGPT's build and release scripts.
#
#   bin/lg <domain> <command> [args…]      bin/lg <command> [args…]
#   bin/lg help [domain]                   bin/lg <domain>  → that domain's help
#
# This file only ROUTES. Every command execs a script in bin/{web,build,ops}/,
# or one that already lives with what it builds (apps/, scripts/), and each of
# those also runs directly:
#
#   web deploy <site…|all> [--dry-run]       the family's sites: app gen verse md world
#   build <target…> [--release] [-- args…]   cli app gen previs md verse all
#   build bundle [--debug] [--dmg]           LocalGPT.app for macOS (signed and notarized when given)
#   verify [--rust|--bevy|--features|--web|--deps]   the CI checks, on this machine
#   fetch model|assets                       the two shared downloads, once per machine
#
# Bash 3.2 safe (macOS /bin/bash).
set -u
LG_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

lg_usage() { # to stdout when asked for help; callers redirect >&2 on errors
  cat <<'EOF'
usage: bin/lg <domain> <command> [args…]   |   bin/lg <command> [args…]

  lg web deploy <site…|all> [--dry-run]   app gen verse md world -> their Cloudflare Workers
  lg build <target…> [--release]          cli app gen previs md verse all (cargo args after --)
  lg build bundle [--debug] [--dmg]       LocalGPT.app (apps/app-desktop/macos/build-app.sh)
  lg verify [--rust|--bevy|…]             the CI checks locally; run before a release or a deploy
  lg fetch model|assets                   the ~5 GB GGUF, the 522 MB CC0 pack
  lg help [domain]                        this menu, or one domain's commands

Every command also runs directly: bin/web/deploy.sh world, bin/build/target.sh app …
EOF
}

lg_domain_help() { # $1 = domain
  case "$1" in
    web) cat >&2 <<'EOF'
  lg web deploy <site…> [--dry-run]   site: app gen verse md world, or all (in that order)
EOF
 ;;
    build) cat >&2 <<'EOF'
  lg build <target…> [--release] [-- <cargo args…>]   cli app gen previs md verse all
  lg build bundle [--debug] [--dmg]                  LocalGPT.app, and a .dmg
EOF
 ;;
    verify) cat >&2 <<'EOF'
  lg verify [--rust] [--bevy] [--features] [--web] [--deps]   default: all, in CI's order
EOF
 ;;
    fetch) cat >&2 <<'EOF'
  lg fetch model     the shared GGUF  -> ~/.local/share/localgpt/models/llm
  lg fetch assets    the CC0 pack     -> ~/.local/share/localgpt/models/pack
EOF
 ;;
    *) lg_usage >&2 ;;
  esac
}

lg_exec() { # lg_exec <script> [args…]
  local script="$1"; shift
  if [ ! -f "$script" ]; then
    echo "lg: missing command script $script" >&2
    exit 2
  fi
  exec "$script" "$@"
}

[ $# -gt 0 ] || { lg_usage >&2; exit 2; }
cmd="$1"; shift
case "$cmd" in
  -h|--help|help)
    if [ $# -gt 0 ]; then lg_domain_help "$1"; else lg_usage; fi
    exit 0
    ;;
  verify) lg_exec "$LG_HOME/ops/verify.sh" "$@" ;;

  web)
    [ $# -gt 0 ] || { lg_domain_help web; exit 2; }
    case "$1" in
      deploy) shift; lg_exec "$LG_HOME/web/deploy.sh" "$@" ;;
      *) lg_domain_help web >&2; exit 2 ;;
    esac ;;

  build)
    [ $# -gt 0 ] || { lg_domain_help build; exit 2; }
    case "$1" in
      bundle) shift; lg_exec "$LG_HOME/../apps/app-desktop/macos/build-app.sh" "$@" ;;
      *) lg_exec "$LG_HOME/build/target.sh" "$@" ;;
    esac ;;

  fetch)
    [ $# -gt 0 ] || { lg_domain_help fetch; exit 2; }
    case "$1" in
      model)  shift; lg_exec "$LG_HOME/../scripts/fetch-model.sh" "$@" ;;
      assets) shift; lg_exec "$LG_HOME/../scripts/fetch-assets.sh" "$@" ;;
      *) lg_domain_help fetch >&2; exit 2 ;;
    esac ;;

  *) lg_usage >&2; exit 2 ;;
esac
